# Copy this file to `.env` and edit it. `.env` is ignored by git and is read when
# the tool starts. Anything already exported in your shell wins over this file, and
# everything after the first `=` is the value, so there are no inline comments.
#
# Every setting below is optional. The tool works with none of them, which is how
# it is run every day.

# -- yt-dlp, if your network needs help ------------------------------------

# Send YouTube requests through a proxy, e.g. http://127.0.0.1:8080 or a
# socks5://host:port. Never commit a proxy that carries credentials.
#WASTATUS_PROXY=

# Borrow cookies from a browser you are signed into, e.g. `chrome`, `firefox`,
# or `chrome:Profile 1`. This is what lets yt-dlp fetch something that asks you
# to prove you are not a robot. It reads your browser profile, so treat it as
# sensitive.
#WASTATUS_COOKIES_FROM_BROWSER=

# -- starting the page ------------------------------------------------------

# Listen on a second address as well as loopback, so a phone can reach the page.
# `tailscale` looks your tailnet address up for you; anything else has to be a
# literal address. Empty, the default, is loopback only.
#
# Whoever can open that page can post to your Status, because the page hands out
# the token that lets it. Put a tailnet here, never a home network.
#WASTATUS_ALSO_ON=

# Start a Chrome with WhatsApp Web in it when the page starts, if one is not
# already running, so posting works without a second command. `1`, `true`, `yes`
# or `on` switches it on. Empty, the default, starts nothing.
#WASTATUS_START_BROWSER=

# Which debug ports to look for that browser on, and to start it on. A list,
# `9230,9231`, or a range, `9230-9235`, or both. The first entry is the one
# preferred. Default: 9222-9226.
#
# Worth setting when something else on the machine opens debug browsers of its
# own. An IDE that takes 9222 and never gives it back is not a fault this tool
# can fix, and a port that is already held is worse than a port that is missing:
# Chrome binds IPv6 only, says it is listening, and cannot be reached.
#WASTATUS_CDP_PORTS=

# -- where things live -----------------------------------------------------

# The posting browser's own Chrome profile, which holds its WhatsApp login.
# Default: ~/.config/chrome-wastatus on Linux.
#WASTATUS_CHROME_DIR=

# Where the session label is written: the tab in the posting browser whose title
# names the port this page is on. Nothing of yours is kept here and deleting it
# costs nothing. Default: ~/.cache/wastatus, or XDG_CACHE_HOME if that is set.
#WASTATUS_CACHE_DIR=

# The sticker library. Default: ~/.local/share/wastatus/stickers on Linux.
#WASTATUS_STICKER_DIR=

# Where run logs are written. Default: the `logs` folder beside the code.
#WASTATUS_LOG_DIR=

# -- the PO token helper ---------------------------------------------------

# Where the helper is installed, and the port it answers on. Change the port only
# if something else on your machine already holds 4416.
#WASTATUS_POT_DIR=
#WASTATUS_POT_PORT=4416

# -- the GIF picker --------------------------------------------------------

# Which service the GIF search uses: `giphy`, `klipy`, or `both`, which asks the two
# at once and mixes their results (both keys below are needed for that). Leave it empty, or delete
# the line, and the whole feature is off: no toggle in the page, no routes on the
# server, and no search term ever leaves this machine. Off is the default.
#WASTATUS_GIF_PROVIDER=

# The key for whichever one you named. The picker stays off until the matching key
# has a value, whatever the line above says, so a half finished setup fails closed
# rather than offering a search box that cannot answer.
#
# GIPHY: developers.giphy.com. Choose **API**, not SDK: the SDK is their own user
# interface components, which this tool does not use, and its key comes with a
# licence for something you are not doing. A beta key allows 100 calls an hour.
#WASTATUS_GIPHY_KEY=

# KLIPY: docs.klipy.com. Their one hard attribution rule is that the search box
# says "Search KLIPY", which this tool does for you.
#WASTATUS_KLIPY_KEY=

# How strict the content filter is: g, pg, pg-13 or r. Default is pg. `g` is
# narrow enough to strip out ordinary celebration and reaction GIFs, which is most
# of what anybody uses. A value that is not one of the four is refused rather than
# guessed at, because a typo quietly meaning `off` is the wrong way to be wrong.
#WASTATUS_GIF_RATING=

# -- reading a different file ----------------------------------------------

# Set this in the environment, not here, to read settings from another path.
#WASTATUS_ENV=

# -- The Google Sheet record -------------------------------------------------
#
# One row per Status WhatsApp accepted: Timestamp, Source, Status, Remarks. A
# refused Status gets no row, because the sheet is the record of what went out.
# Leave WASTATUS_SHEET_ID unset and none of this runs.
#
# Set up once:
#   gcloud services enable sheets.googleapis.com --project=<your project>
#   gcloud iam service-accounts keys create ~/.config/wastatus/sheets-sa.json \
#       --iam-account=<name>@<project>.iam.gserviceaccount.com
#   chmod 600 ~/.config/wastatus/sheets-sa.json
# then share the sheet with that same address as an Editor.
#
# WASTATUS_SHEET_ID=<the long string in your sheet URL, between /d/ and /edit>
# WASTATUS_SHEET_KEY=~/.config/wastatus/sheets-sa.json
# WASTATUS_SHEET_TAB=Sheet1

# -- Trying again when WhatsApp refuses a Status ------------------------------
#
# A refusal is retried, because WhatsApp answering no means nothing went out. No
# answer at all is never retried: that Status may yet go out. Three goes, twenty
# seconds apart and doubling.
#
# WASTATUS_POST_ATTEMPTS=3
# WASTATUS_POST_BACKOFF=20

# -- The hosted renderer (only on the server the browser extension uploads to) --
#
# `wastatus hosted serve` keeps uploads, finished clips and the token file here.
# Default ~/.local/share/wastatus/hosted. The container sets /data.
#
#WASTATUS_HOSTED_DATA=
#
# Renders at once. ffmpeg uses every core it is given, so one is right for a
# four core machine shared with other services.
#
#WASTATUS_HOSTED_WORKERS=1

# -- SnipShare: the hosted page (only on the server that runs it) ----------------
#
# Every value below is the server's own, kept in its `.env` (mode 600) and never in
# the repository: the site's address, who administers it, and the keys. Leave them
# all unset on a machine that only runs the local tool.
#
# The site's own address, scheme and host: https://snipshare.example.com
#WASTATUS_PUBLIC_URL=
#
# Who administers it: approves requests, sees usage, suspends. Comma separated.
# Everyone listed is let in at start; anyone taken off the list stops being admin.
#WASTATUS_ADMIN_EMAILS=
#
# A long random string. GIF keys people add are stored encrypted with a key made
# from it, so changing it makes the stored ones unreadable (people add them again).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#WASTATUS_SECRET_KEY=
#
# Each person's day: clips made, and MB uploaded by the extension. Default 10 and 500.
#WASTATUS_CLIPS_PER_DAY=
#WASTATUS_UPLOAD_MB_PER_DAY=
#
# Renders across everybody in an hour, before new ones are refused. Default 60.
#WASTATUS_RENDERS_PER_HOUR=
#
# Google sign-in: the OAuth client id of a "Web application" client whose
# authorised JavaScript origin is the site above. The id is not a secret.
#WASTATUS_GOOGLE_CLIENT_ID=
#
# Cloudflare Turnstile, on the request access form. Without a secret the check is
# skipped, which is only right for a local copy.
#WASTATUS_TURNSTILE_SITEKEY=
#WASTATUS_TURNSTILE_SECRET=
#
# Telling the owner about a request, a problem report or an alert. Mail goes only
# to WASTATUS_MAIL_TO, never to anybody who typed an address into a form.
#WASTATUS_RESEND_KEY=
#WASTATUS_MAIL_FROM=
#WASTATUS_MAIL_TO=
#WASTATUS_CHAT_WEBHOOK=
#
# The id of the extension built for this site (scripts/build_extension.py prints it),
# so the page knows which extension to talk to.
#WASTATUS_EXTENSION_ID=
#
# What the public pages say: who runs the site, where to write, and a status page.
#WASTATUS_OPERATOR=
#WASTATUS_CONTACT_EMAIL=
#WASTATUS_STATUS_URL=
#
# Where this site's source code is published; every page's footer links to it.
# Empty means the project's public repository. A copy you have changed must point
# at your own published changes.
#WASTATUS_SOURCE_URL=
#
# Trust Cloudflare's CF-Connecting-IP header for the caller's address. Only behind
# a tunnel or proxy that sets it; the Compose file sets it for the container.
#WASTATUS_TRUST_PROXY=
