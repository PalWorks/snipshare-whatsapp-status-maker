{
  "manifest_version": 3,
  "name": "SnipShare",
  "version": "2.1.1",
  "description": "Status Maker for WhatsApp, from YouTube videos. Reads the part you choose in your own browser, and places the clip in WhatsApp Web for you to send.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open SnipShare",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "downloads",
    "notifications",
    "idle",
    "unlimitedStorage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://i.ytimg.com/*",
    "https://web.whatsapp.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "queue.html",
        "queue.css",
        "queue.js",
        "queue-page.js"
      ],
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "media.js",
        "recorder.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
